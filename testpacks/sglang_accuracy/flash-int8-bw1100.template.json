{
  "version": 1,
  "name": "deepseek-v4-flash-channel-int8-bw1100-8x-sglang-0.5.12",
  "reference": "https://github.com/HYGON-AI/inference-cookbook-das/blob/89cc09d13325a5fdb420c8e52c1148f902f3c6ae/docs/model-deployment/sglang/deepseek-v4.md",
  "notes": "BW1100 8-card reference only. Confirm hardware, model, NICs and image before running. No DTK or package installation.",
  "visible_gpus": 8,
  "require_memlock_unlimited": true,
  "server_argv": [
    "sglang", "serve", "--trust-remote-code", "--model-path", "${model_path}",
    "--tp", "8", "--dp", "8", "--host", "${host}", "--port", "${port}",
    "--enable-dp-attention", "--moe-a2a-backend", "deepep", "--deepep-mode", "auto",
    "--chunked-prefill-size", "32768", "--deepep-config", "${ep_config}",
    "--speculative-num-steps", "3", "--speculative-eagle-topk", "1", "--speculative-num-draft-tokens", "4",
    "--mem-fraction-static", "0.84", "--quantization", "slimquant_marlin",
    "--disable-flashinfer-autotune", "--cuda-graph-max-bs", "64"
  ],
  "unset_env": ["SGLANG_DEEPEP_BF16_DISPATCH"],
  "env": {
    "NCCL_IB_HCA": "YOUR_IB_HCA_LIST",
    "NCCL_SOCKET_IFNAME": "YOUR_SOCKET_INTERFACE",
    "GLOO_SOCKET_IFNAME": "YOUR_SOCKET_INTERFACE",
    "ROCSHMEM_GDA_NUM_QPS_DEFAULT_CTX": "288",
    "ROCSHMEM_MAX_NUM_CONTEXTS": "48",
    "ROCSHMEM_HEAP_SIZE": "3737418240",
    "SGL_CHUNKED_PREFIX_CACHE_THRESHOLD": "0",
    "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "1200",
    "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=0x40000",
    "SGLANG_SET_CPU_AFFINITY": "1",
    "HIP_KERNEL_BATCH_CEILING": "100",
    "GPU_MAX_HW_QUEUES": "3",
    "HIP_H2D_DISABLE_COPY_BUFFER": "0",
    "HIP_D2H_DISABLE_COPY_BUFFER": "0",
    "HIP_H2D_DIRECT_COPY_THRESHOLD": "32768",
    "HIP_H2D_HSAAPI_COPY_THRESHOLD": "32768",
    "HIP_D2H_DIRECT_COPY_THRESHOLD": "512",
    "HIP_D2H_HSAAPI_COPY_THRESHOLD": "512",
    "USE_DCU_CUSTOM_ALLREDUCE": "0",
    "SGLANG_OPT_DEEPGEMM_HC_PRENORM": "0",
    "HIP_KERNEL_EVENT_SYSTENFENCE": "1",
    "SGLANG_USE_FP8_W8A8_MOE": "0",
    "SGLANG_GROUPGEMM": "true",
    "SGLANG_USE_LIGHTOP": "1",
    "SGLANG_OPT_USE_FUSED_HASH_TOPK": "true",
    "SGLANG_OPT_SWIGLU_CLAMP_FUSION": "false",
    "SGLANG_OPT_USE_JIT_KERNEL_FUSED_TOPK": "true",
    "SGLANG_NSA_FUSE_TOPK": "false",
    "SGLANG_JIT_DEEPGEMM_PRECOMPILE": "0",
    "SGLANG_APPLY_CONFIG_BACKUP": "none",
    "SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK": "256",
    "SGLANG_DSV4_MODE": "2604",
    "SGLANG_DSV4_DEEPEP_TP_SHARD_QUANT": "0",
    "SGLANG_ROCM_USE_AITER_MOE": "1",
    "SGLANG_ROCM_USE_AITER_TILELANG_MHC": "1",
    "SGLANG_TOPK_TRANSFORM_512_TORCH": "false",
    "SGLANG_USE_FUSED_DPSKV4_QNORM_ROPE_KV_ROPE_QUANT": "1",
    "PYTORCH_HIP_ALLOC_CONF": "expandable_segments:True",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
  }
}
